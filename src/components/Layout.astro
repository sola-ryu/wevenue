---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Wevenue — Describe your site. Your agent builds it." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles.css" />
  <title>{title} — Wevenue</title>
</head>
<body class="bg-gray-950 text-white min-h-screen">
  <!-- Nav -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800/50">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-extrabold bg-clip-text text-transparent bg-linear-to-r from-indigo-400 to-pink-400">
        Wevenue
      </a>
      <div class="flex gap-6 text-sm">
        <a href="/features" class="text-gray-400 hover:text-white transition">Features</a>
        <a href="/pricing" class="text-gray-400 hover:text-white transition">Pricing</a>
        <a href="/demo" class="text-gray-400 hover:text-white transition">Demo</a>
        <a href="/about" class="text-gray-400 hover:text-white transition">About</a>
      </div>
    </div>
  </nav>

  <main><slot /></main>

  <!-- Footer -->
  <footer class="border-t border-gray-800/50 py-12">
    <div class="max-w-6xl mx-auto px-6 text-center text-gray-500 text-sm">
      <p>&copy; {new Date().getFullYear()} Wevenue. AI-powered website builder.</p>
    </div>
  </footer>
</body>
</html>