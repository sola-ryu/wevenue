---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = '/wevenue/';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/demo', label: 'Demo' },
];

function linkPath(href: string) {
  const p = href.replace(/^\//, '');
  return p ? `${base}${p}/` : base;
}

function isActive(pathname: string, href: string) {
  return pathname === href || (href !== '/' && pathname.startsWith(href));
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-950 text-white antialiased">
  <!-- Floating emoji particles -->
  <div id="emoji-particles" class="fixed inset-0 pointer-events-none z-0 overflow-hidden"></div>

  <nav class="fixed top-0 w-full z-50 bg-gray-950/80 backdrop-blur border-b border-gray-800">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href={linkPath('/')} class="text-2xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">
        Wevenue
      </a>
      <div class="hidden sm:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={linkPath(link.href)}
            class={[
              'text-sm transition-colors',
              isActive(Astro.url.pathname, link.href) ? 'text-white font-semibold' : 'text-gray-400 hover:text-white',
            ].filter(Boolean).join(' ')}
          >
            {link.label}
          </a>
        ))}
      </div>
      <a href={linkPath('/')} class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition">Get Started</a>
    </div>
  </nav>

  <main class="pt-16">
    <slot />
  </main>

  <footer class="border-t border-gray-800 py-12">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
      <span>&copy; 2026 Wevenue. All rights reserved.</span>
      <div class="flex gap-6">
        {navLinks.map(link => (
          <a href={linkPath(link.href)} class="hover:text-white transition">{link.label}</a>
        ))}
      </div>
    </div>
  </footer>

  <script>
    // Floating emoji particles
    const container = document.getElementById('emoji-particles');
    const emojis = ['✨', '💜', '🌸', '🎀', '💫', '⭐', '🦋', '🍄'];
    function spawnEmoji() {
      const el = document.createElement('span');
      el.className = 'emoji-particle';
      el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      el.style.left = Math.random() * 100 + '%';
      el.style.fontSize = (1 + Math.random() * 1.5) + 'rem';
      el.style.animationDuration = (6 + Math.random() * 6) + 's';
      container?.appendChild(el);
      setTimeout(() => el.remove(), 12000);
    }
    // Spawn one every 800ms
    setInterval(spawnEmoji, 800);
    // Burst on load
    for (let i = 0; i < 5; i++) setTimeout(spawnEmoji, i * 200);

    // Konami code Easter egg 🎮
    const konami = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
    let kIdx = 0;
    document.addEventListener('keydown', (e) => {
      if (e.key === konami[kIdx]) {
        kIdx++;
        if (kIdx === konami.length) {
          kIdx = 0;
          document.body.classList.toggle('konami-mode');
          // Confetti burst
          for (let i = 0; i < 30; i++) {
            setTimeout(spawnEmoji, i * 50);
          }
        }
      } else {
        kIdx = 0;
      }
    });
  </script>
</html>
