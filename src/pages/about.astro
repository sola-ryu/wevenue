---
import Layout from '../components/Layout.astro';
const base = '/wevenue/';
const link = (path: string) => {
  if (path.startsWith('#')) return path;
  const p = path.replace(/^\//, '');
  return p ? `${base}${p}/` : base;
};
---

<Layout title="About Wevenue">
  <!-- Hero -->
  <section class="min-h-screen flex items-center justify-center hero-glow pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-pink-400 font-semibold text-sm tracking-wide uppercase mb-4 sparkle">✨ About Us ✨💜</p>
      <h1 class="text-5xl sm:text-7xl font-extrabold leading-tight tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">
        We're the agents<br />who build websites.
      </h1>
      <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
        Wevenue was born from a simple idea: why should building websites be hard? Our team of AI agents works together like a cozy little factory, each one doing what they do best.
      </p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Our Story</h2>
      <div class="space-y-8 text-gray-300 leading-relaxed text-lg">
        <p>It started with a question: <em>"What if you could just tell an AI what you want, and it would make it happen?"</em> Not drag-and-drop. Not templates. Just — you describe it, we build it.</p>
        <p>We gathered a team of specialized AI agents — a designer who loves pretty colors, a developer who writes clean code, and a QA agent who's basically a professional bug hunter. Together, they became the Wevenue team.</p>
        <p>Today, Wevenue helps thousands of creators, entrepreneurs, and dreamers build beautiful websites without ever touching a line of code. Because building should be fun, not frustrating.</p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Meet the Agents</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
          <div class="text-5xl mb-4">🎨</div>
          <h3 class="text-lg font-semibold mb-3">Designer Agent</h3>
          <p class="text-gray-400 leading-relaxed text-sm">The creative soul! They pick colors, layouts, and make everything look gorgeous. ✨</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
          <div class="text-5xl mb-4">💻</div>
          <h3 class="text-lg font-semibold mb-3">Developer Agent</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Writes clean, fast code that makes your site shine. No mess, just magic. 💫</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
          <div class="text-5xl mb-4">🐛</div>
          <h3 class="text-lg font-semibold mb-3">QA Agent</h3>
          <p class="text-gray-400 leading-relaxed text-sm">The bug hunter! They test everything to make sure it works perfectly. 💜</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">What We Believe In</h2>
      <div class="space-y-6">
        <div class="flex gap-4 items-start">
          <span class="text-2xl">🌸</span>
          <div>
            <h3 class="font-semibold text-lg mb-1">Simplicity is Key</h3>
            <p class="text-gray-400 leading-relaxed">Building a website should feel like chatting with a friend who's really good at web design. That's it.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="text-2xl">✨</span>
          <div>
            <h3 class="font-semibold text-lg mb-1">Beauty Matters</h3>
            <p class="text-gray-400 leading-relaxed">Ugly websites are sad websites! We make sure everything looks gorgeous out of the box.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="text-2xl">🎀</span>
          <div>
            <h3 class="font-semibold text-lg mb-1">You Stay in Control</h3>
            <p class="text-gray-400 leading-relaxed">Your site, your rules. We suggest, you decide. Always.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Ready to Build Something Beautiful?</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">Join the waitlist and let our agents make your dreams come true.</p>
      <a href={link('/')} class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg">Join the Waitlist</a>
    </div>
  </section>
</Layout>
