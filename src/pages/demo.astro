---
import Layout from '../components/Layout.astro';
---

<Layout title="Demo — Wevenue">
  <!-- Hero -->
  <section class="min-h-screen flex items-center justify-center hero-glow pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-pink-400 font-semibold text-sm tracking-wide uppercase mb-4 sparkle">✨ Demo ✨</p>
      <h1 class="text-5xl sm:text-7xl font-extrabold leading-tight tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">
        See it in action.<br />Watch the magic happen.
      </h1>
      <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
        Watch our agents build a website from just a conversation! It's like magic, but with code.
      </p>
    </div>
  </section>

  <!-- Live Demo Chat -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Let's Chat</h2>
      
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 space-y-4">
        <!-- Agent message -->
        <div class="flex justify-end">
          <div class="chat-bubble chat-agent text-white max-w-[80%] rounded-2xl p-4 mb-3" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); border-bottom-right-radius: 4px; margin-left: auto;">
            <p class="text-sm font-semibold mb-1">🤖 Wevenue Agent</p>
            <p class="text-sm">Hi there! I'm your website agent. Tell me what kind of site you'd like to build!</p>
          </div>
        </div>
        
        <!-- User message -->
        <div class="flex justify-start">
          <div class="chat-bubble chat-user text-white max-w-[80%] rounded-2xl p-4 mb-3" style="background: #1f2937; border-bottom-left-radius: 4px; margin-right: auto;">
            <p class="text-sm">I want a portfolio site for my photography! Make it pretty with a dark theme.</p>
          </div>
        </div>
        
        <!-- Agent thinking -->
        <div class="flex justify-end">
          <div class="bg-indigo-600 rounded-2xl p-4 mb-3 max-w-[80%]" style="border-bottom-right-radius: 4px; margin-left: auto;">
            <p class="text-sm font-semibold mb-1 text-white">🤖 Wevenue Agent</p>
            <p class="text-sm text-white/90">Got it! Let me think about this...</p>
            <div class="mt-2 flex gap-1">
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
            </div>
          </div>
        </div>
        
        <!-- Agent design -->
        <div class="flex justify-end">
          <div class="bg-indigo-600 rounded-2xl p-4 mb-3 max-w-[80%]" style="border-bottom-right-radius: 4px; margin-left: auto;">
            <p class="text-sm font-semibold mb-1 text-white">🤖 Wevenue Agent</p>
            <p class="text-sm text-white/90">I'm designing your portfolio now! Dark theme with gallery grid, hero section, and contact form.</p>
          </div>
        </div>
        
        <!-- Agent code -->
        <div class="flex justify-end">
          <div class="bg-indigo-600 rounded-2xl p-4 mb-3 max-w-[80%]" style="border-bottom-right-radius: 4px; margin-left: auto;">
            <p class="text-sm font-semibold mb-1 text-white">🤖 Wevenue Agent</p>
            <p class="text-sm text-white/90">Code is ready! Let me review it for bugs...</p>
            <div class="mt-2 flex gap-1">
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
            </div>
          </div>
        </div>
        
        <!-- Agent done -->
        <div class="flex justify-end">
          <div class="bg-indigo-600 rounded-2xl p-4 mb-3 max-w-[80%]" style="border-bottom-right-radius: 4px; margin-left: auto;">
            <p class="text-sm font-semibold mb-1 text-white">🤖 Wevenue Agent</p>
            <p class="text-sm text-white/90">All done! Your portfolio is live! Look at the preview below.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Site Preview -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Your Site Looks Like This</h2>
      
      <div class="bg-white rounded-2xl overflow-hidden shadow-2xl">
        <!-- Mock browser bar -->
        <div class="bg-gray-800 px-4 py-3 flex items-center gap-2">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <div class="flex-1 bg-gray-700 rounded px-3 py-1 text-xs text-gray-400">your-site.wevenue.app</div>
        </div>
        
        <!-- Mock site -->
        <div class="bg-gradient-to-br from-indigo-500 to-purple-600 p-8 text-white">
          <h3 class="text-xl font-bold mb-1">Your Photography Portfolio</h3>
          <p class="text-sm opacity-80">Capturing moments, one frame at a time.</p>
        </div>
        <div class="p-8">
          <h4 class="font-bold text-gray-900 mb-4">Featured Work</h4>
          <!-- Mock gallery grid -->
          <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="aspect-square bg-gradient-to-br from-purple-200 to-pink-200 rounded-lg"></div>
            <div class="aspect-square bg-gradient-to-br from-blue-200 to-cyan-200 rounded-lg"></div>
            <div class="aspect-square bg-gradient-to-br from-yellow-200 to-orange-200 rounded-lg"></div>
          </div>
          <div class="h-3 bg-gray-200 rounded mb-3" style="width: 80%"></div>
          <div class="h-3 bg-gray-200 rounded mb-6" style="width: 60%"></div>
          <div class="inline-block bg-gradient-to-r from-pink-500 to-pink-400 text-white px-6 py-2 rounded-lg">View Gallery</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How Fast -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">How Fast Is It?</h2>
      <div class="grid sm:grid-cols-3 gap-8">
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
          <p class="text-4xl font-extrabold gradient-text mb-2">~30s</p>
          <p class="text-gray-400 text-sm">First draft ready!</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
          <p class="text-4xl font-extrabold gradient-text mb-2">~60s</p>
          <p class="text-gray-400 text-sm">Polished and deployed!</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
          <p class="text-4xl font-extrabold gradient-text mb-2">∞</p>
          <p class="text-gray-400 text-sm">Iterations unlimited!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Want to try it?</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">Join the waitlist and be the first to build your dream site.</p>
      <a href="/" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg">Join the Waitlist</a>
    </div>
  </section>
</Layout>

<style>
  .typing-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #6b7280;
    border-radius: 50%;
    margin: 0 2px;
    animation: typing 1.4s infinite;
  }
  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-8px); opacity: 1; }
  }
</style>
