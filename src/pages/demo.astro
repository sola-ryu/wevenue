---
import Layout from '../components/Layout.astro';
const base = '/wevenue/';
const link = (path: string) => {
  if (path.startsWith('#')) return path;
  const p = path.replace(/^\//, '');
  return p ? `${base}${p}/` : base;
};


---

<Layout title="Demo — Wevenue">
  <!-- Hero -->
  <section class="min-h-screen flex items-center justify-center hero-glow pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-pink-400 font-semibold text-sm tracking-wide uppercase mb-4 sparkle">✨ Live Demo ✨</p>
      <h1 class="text-5xl sm:text-7xl font-extrabold leading-tight tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">
        Watch our agents<br />build a site live.
      </h1>
      <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
        This is what it looks like when AI agents collaborate on your website. Hit play and watch the magic unfold! ✨
      </p>
    </div>
  </section>

  <!-- Live Demo Chat -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Agent Collaboration in Action 💬</h2>
      
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 space-y-4 relative overflow-hidden" id="demo-chat">
        <!-- Play button overlay -->
        <div id="chat-overlay" class="absolute inset-0 bg-gray-900/80 backdrop-blur-sm flex items-center justify-center z-10 cursor-pointer rounded-2xl">
          <button onclick="playDemo()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-4 rounded-xl transition text-lg flex items-center gap-3">
            <span class="text-2xl">▶</span> Play Demo
          </button>
        </div>
        
        <!-- Messages will be injected here -->
        <div id="chat-messages" class="space-y-4"></div>
      </div>
    </div>
  </section>

  <!-- Site Preview -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">The Result 💜</h2>
      
      <div class="bg-white rounded-2xl overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300">
        <!-- Mock browser bar -->
        <div class="bg-gray-800 px-4 py-3 flex items-center gap-2">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <div class="flex-1 bg-gray-700 rounded px-3 py-1 text-xs text-gray-400">your-photography.wevenue.app</div>
        </div>
        
        <!-- Mock site -->
        <div class="bg-gradient-to-br from-indigo-900 to-purple-900 p-8 text-white">
          <h3 class="text-xl font-bold mb-1">Your Photography Portfolio</h3>
          <p class="text-sm opacity-80">Capturing moments, one frame at a time.</p>
        </div>
        <div class="p-8">
          <h4 class="font-bold text-gray-900 mb-4">Featured Work</h4>
          <!-- Mock gallery grid -->
          <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="aspect-square bg-gradient-to-br from-purple-200 to-pink-200 rounded-lg hover:scale-105 transition-transform"></div>
            <div class="aspect-square bg-gradient-to-br from-blue-200 to-cyan-200 rounded-lg hover:scale-105 transition-transform"></div>
            <div class="aspect-square bg-gradient-to-br from-yellow-200 to-orange-200 rounded-lg hover:scale-105 transition-transform"></div>
          </div>
          <div class="h-3 bg-gray-200 rounded mb-3" style="width: 80%"></div>
          <div class="h-3 bg-gray-200 rounded mb-6" style="width: 60%"></div>
          <div class="inline-block bg-gradient-to-r from-pink-500 to-pink-400 text-white px-6 py-2 rounded-lg hover:shadow-lg transition-shadow cursor-pointer">View Gallery</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How Fast -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Speed Run 💫</h2>
      <div class="grid sm:grid-cols-3 gap-8">
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <p class="text-4xl font-extrabold gradient-text mb-2">~30s</p>
          <p class="text-gray-400 text-sm">First draft ready! ✨</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <p class="text-4xl font-extrabold gradient-text mb-2">~60s</p>
          <p class="text-gray-400 text-sm">Polished and deployed! 💜</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <p class="text-4xl font-extrabold gradient-text mb-2">∞</p>
          <p class="text-gray-400 text-sm">Iterations unlimited! ✨</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Want to try it? ✨</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">Join the waitlist and be the first to build your dream site. 💫</p>
      <a href={link('/')} class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg">Join the Waitlist</a>
    </div>
  </section>

  <script>
    // Chat messages with typing delay (ms) and display delay (ms)
    const chatMessages = [
      { type: 'agent', text: "Hi there! 👋 I'm your Wevenue agent. Tell me what kind of site you'd like to build!", delay: 500 },
      { type: 'user', text: "I want a portfolio site for my photography! Make it pretty with a dark theme.", delay: 1500 },
      { type: 'agent', text: "Got it! A photography portfolio with a dark theme — love that combo. Let me think about this...", delay: 2000, thinking: true },
      { type: 'agent', text: "🎨 Designer (Pixel): 'I'm going with deep navy backgrounds, gallery grid with hover zoom, and gold accent buttons.'", delay: 3500 },
      { type: 'agent', text: "💻 Developer (Semicolon): 'Writing semantic HTML, CSS Grid for the gallery, lazy-loaded images. Clean code, no compromises.'", delay: 5000 },
      { type: 'agent', text: "🐛 QA (Bugger): 'Found and fixed 2 issues. The contact form had a missing label. Noted. Moving on.'", delay: 6500 },
      { type: 'agent', text: "All done! ✅ Your portfolio is live at your-photography.wevenue.app — check the preview below!", delay: 8000 },
    ];

    const chatContainer = document.getElementById('chat-messages');
    const overlay = document.getElementById('chat-overlay');

    function createMessage(type, text) {
      const wrapper = document.createElement('div');
      wrapper.className = `flex ${type === 'user' ? 'justify-start' : 'justify-end'} opacity-0`;
      wrapper.style.transition = 'opacity 0.4s ease';

      const bubble = document.createElement('div');
      bubble.className = `${type === 'agent' 
        ? 'bg-indigo-600 text-white' 
        : 'bg-gray-800 text-white'} max-w-[80%] rounded-2xl p-4 ${type === 'agent' ? 'border-bottom-right-radius: 4px; margin-left: auto;' : 'border-bottom-left-radius: 4px; margin-right: auto;'}`;

      if (type === 'agent') {
        const name = document.createElement('p');
        name.className = 'text-sm font-semibold mb-1';
        name.textContent = '🤖 Wevenue Agent';
        bubble.appendChild(name);
      }

      const content = document.createElement('p');
      content.className = 'text-sm leading-relaxed';
      content.textContent = text;
      bubble.appendChild(content);

      wrapper.appendChild(bubble);
      return wrapper;
    }

    function createThinkingMessage() {
      const wrapper = document.createElement('div');
      wrapper.className = 'flex justify-end opacity-0';
      wrapper.style.transition = 'opacity 0.4s ease';

      const bubble = document.createElement('div');
      bubble.className = 'bg-indigo-600/80 max-w-[80%] rounded-2xl p-4 border-bottom-right-radius: 4px; margin-left: auto;';

      const name = document.createElement('p');
      name.className = 'text-sm font-semibold mb-2 text-white/90';
      name.textContent = '🤖 Wevenue Agent';
      bubble.appendChild(name);

      const dots = document.createElement('div');
      dots.className = 'flex gap-1.5 mt-2';
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.className = 'w-2 h-2 bg-white/60 rounded-full animate-bounce';
        dot.style.animationDelay = `${i * 0.15}s`;
        dots.appendChild(dot);
      }
      bubble.appendChild(dots);

      wrapper.appendChild(bubble);
      return wrapper;
    }

    window.playDemo = function() {
      overlay.style.display = 'none';
      chatContainer.innerHTML = '';

      chatMessages.forEach((msg, i) => {
        setTimeout(() => {
          const el = msg.thinking 
            ? createThinkingMessage() 
            : createMessage(msg.type, msg.text);
          chatContainer.appendChild(el);
          // Trigger fade-in
          requestAnimationFrame(() => {
            el.style.opacity = '1';
          });
          // Scroll into view
          el.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }, msg.delay);
      });
    };
  </script>
</Layout>
