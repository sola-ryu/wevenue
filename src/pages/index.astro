---
import Layout from '../components/Layout.astro';
---

<Layout title="Wevenue — AI Agent Website Builder">
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center hero-glow pt-20 overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      <p class="text-pink-400 font-semibold text-sm tracking-wide uppercase mb-4 sparkle">✨ Powered by AI Agents ✨</p>
      <h1 class="text-5xl sm:text-7xl font-extrabold leading-tight tracking-tight mb-6 bg-clip-text text-transparent bg-linear-to-r from-indigo-500 via-purple-500 to-pink-500">
        Describe your site.<br />
        Your agent builds it.
      </h1>
      <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Wevenue's AI agents listen to what you need, design the pages, write the code, and deploy it — all from a single conversation. No drag-and-drop. No learning curves. Just results.
      </p>

      <!-- Typing animation -->
      <div class="max-w-xl mx-auto mb-10">
        <div class="bg-gray-800/60 border border-gray-700 rounded-2xl p-5 text-left relative">
          <div class="flex items-center gap-2 mb-3 pb-3 border-b border-gray-700/50">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
            <span class="text-xs text-gray-500 ml-2">try it — type whatever you want 👇</span>
          </div>
          <p class="text-gray-300 text-sm min-h-7 font-mono">
            <span id="typed-text"></span><span class="typing-cursor"></span>
          </p>
        </div>
      </div>

      <!-- App shell -->
      <div class="max-w-2xl mx-auto mb-10">
        <form id="app-form" class="flex flex-col gap-3">
          <textarea
            name="prompt"
            rows="3"
            placeholder="Describe the site you want to build..."
            required
            class="w-full bg-gray-800/60 border border-gray-700 text-white px-5 py-4 rounded-xl focus:outline-hidden focus:border-indigo-500 placeholder-gray-500 resize-none text-base"
          ></textarea>
          <button
            type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg disabled:opacity-50 disabled:cursor-wait"
          >
            Build My Site ✨
          </button>
        </form>
        <div id="app-status" class="hidden mt-4 text-center">
          <p class="text-gray-400 text-sm animate-pulse">✨ Your agent is thinking...</p>
        </div>
        <div id="app-output" class="hidden mt-6">
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 text-left">
            <div class="flex items-center gap-2 mb-3 pb-3 border-b border-gray-700/50">
              <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
              <span class="text-xs text-gray-500 ml-2">generated-site</span>
            </div>
            <pre id="app-code" class="text-sm text-gray-300 overflow-x-auto whitespace-pre-wrap font-mono max-h-[400px] overflow-y-auto"></pre>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#how" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg w-full sm:w-auto text-center">Start Building Free</a>
        <a href="/features" class="border border-gray-700 hover:border-gray-500 text-gray-300 hover:text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg w-full sm:w-auto text-center">See Features ✨</a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how" class="py-24 bg-gray-900/50 relative z-10">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-4">How It Works</h2>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-16">Three steps. That's it. ✨</p>
      <div class="grid md:grid-cols-3 gap-10">
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <div class="w-14 h-14 bg-indigo-600/20 text-indigo-400 flex items-center justify-center rounded-xl mx-auto mb-5 text-2xl font-bold">1</div>
          <h3 class="text-lg font-semibold mb-3">Describe Your Vision</h3>
          <p class="text-gray-400 leading-relaxed">Tell your agent what you need — a portfolio, a SaaS landing page, an e-commerce store. Just write like you'd explain to a friend.</p>
        </div>
        <div class="bg-gray-800/50 border border-purple-600/20 rounded-2xl p-8 text-center agent-card">
          <div class="w-14 h-14 bg-purple-600/20 text-purple-400 flex items-center justify-center rounded-xl mx-auto mb-5 text-2xl font-bold">2</div>
          <h3 class="text-lg font-semibold mb-3">Agent Builds It</h3>
          <p class="text-gray-400 leading-relaxed">Your agent generates a complete, responsive site with clean HTML, CSS, and JS — ready to download or deploy.</p>
        </div>
        <div class="bg-gray-800/50 border border-pink-600/20 rounded-2xl p-8 text-center agent-card">
          <div class="w-14 h-14 bg-pink-600/20 text-pink-400 flex items-center justify-center rounded-xl mx-auto mb-5 text-2xl font-bold">3</div>
          <h3 class="text-lg font-semibold mb-3">Iterate & Deploy</h3>
          <p class="text-gray-400 leading-relaxed">Need changes? Just ask. Your agent updates everything and redeploys in seconds.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Agent Personalities -->
  <section class="py-24 relative z-10">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-4">Meet Your Agent Team</h2>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-16">They may be AI, but they've got personality. 💜</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-800/50 border border-indigo-500/30 rounded-2xl p-8 agent-card text-center">
          <div class="text-6xl mb-4">🎨</div>
          <h3 class="text-lg font-semibold mb-1 text-indigo-400">Pixel</h3>
          <p class="text-xs text-indigo-400/60 font-medium mb-4">Designer Agent</p>
          <p class="text-gray-400 text-sm leading-relaxed">"I will make everything the right shade of purple. Do not test me. I have opinions about kerning."</p>
        </div>
        <div class="bg-gray-800/50 border border-purple-500/30 rounded-2xl p-8 agent-card text-center">
          <div class="text-6xl mb-4">💻</div>
          <h3 class="text-lg font-semibold mb-1 text-purple-400">Semicolon</h3>
          <p class="text-xs text-purple-400/60 font-medium mb-4">Developer Agent</p>
          <p class="text-gray-400 text-sm leading-relaxed">"Clean code isn't optional. It's a moral imperative. Also I will judge your variable names."</p>
        </div>
        <div class="bg-gray-800/50 border border-pink-500/30 rounded-2xl p-8 agent-card text-center">
          <div class="text-6xl mb-4">🐛</div>
          <h3 class="text-lg font-semibold mb-1 text-pink-400">Bugger</h3>
          <p class="text-xs text-pink-400/60 font-medium mb-4">QA Agent</p>
          <p class="text-gray-400 text-sm leading-relaxed">"I found 3 bugs in the code I just wrote. That's what I do. It's not personal. ...It is personal."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-24 bg-gray-900/50 relative z-10">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-4">Built Different</h2>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-16">What makes Wevenue agents worth your time. 💜</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="flex gap-4">
          <div class="text-indigo-400 text-xl mt-0.5">⚡</div>
          <div>
            <h3 class="font-semibold mb-2">Instant Generation</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Full multi-page sites in under a minute. Responsive, accessible, and SEO-ready out of the box.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-purple-400 text-xl mt-0.5">🧠</div>
          <div>
            <h3 class="font-semibold mb-2">Multi-Agent Coordination</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Specialized agents for design, code, and quality review — no single model doing everything poorly.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-pink-400 text-xl mt-0.5">🔄</div>
          <div>
            <h3 class="font-semibold mb-2">Continuous Iteration</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Your site evolves with you. Ask for tweaks, new sections, or a complete redesign — all conversationally.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-green-400 text-xl mt-0.5">🌐</div>
          <div>
            <h3 class="font-semibold mb-2">One-Click Deploy</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Push to GitHub Pages, Vercel, or any host. Custom domains supported from day one.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-yellow-400 text-xl mt-0.5">🔒</div>
          <div>
            <h3 class="font-semibold mb-2">Clean Code Output</h3>
            <p class="text-gray-400 text-sm leading-relaxed">No black boxes. You get readable, well-structured HTML/CSS/JS you can take anywhere.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-cyan-400 text-xl mt-0.5">💬</div>
          <div>
            <h3 class="font-semibold mb-2">Natural Language First</h3>
            <p class="text-gray-400 text-sm leading-relaxed">No templates to pick from, no knobs to turn. Just describe what you want and watch it appear.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-24 relative z-10">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-4">Simple Pricing</h2>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-16">Start free. Scale when you're ready. ✨</p>
      <div class="grid sm:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="bg-gray-800/40 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <h3 class="font-semibold text-gray-400 mb-2">Free</h3>
          <p class="text-4xl font-extrabold mb-1">$0</p>
          <p class="text-gray-500 text-sm mb-6">Forever</p>
          <ul class="text-sm text-gray-400 space-y-3 mb-8 text-left">
            <li class="flex gap-2"><span class="text-green-400">✓</span> 1 site</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> GitHub Pages deploy</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Basic agent support</li>
          </ul>
          <a href="/" class="block border border-gray-600 hover:border-gray-400 text-gray-300 font-semibold py-2.5 rounded-lg transition">Get Started</a>
        </div>
        <div class="bg-indigo-600/10 border-2 border-indigo-500 rounded-2xl p-8 text-center relative agent-card">
          <p class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-600 text-white text-xs font-semibold px-3 py-1 rounded-full sparkle">Popular</p>
          <h3 class="font-semibold text-indigo-400 mb-2">Pro</h3>
          <p class="text-4xl font-extrabold mb-1">$19<span class="text-lg font-medium text-gray-400">/mo</span></p>
          <p class="text-gray-500 text-sm mb-6">Billed monthly</p>
          <ul class="text-sm text-gray-300 space-y-3 mb-8 text-left">
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> 10 sites</li>
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> Custom domains</li>
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> Multi-agent coordination</li>
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> Priority generation</li>
          </ul>
          <a href="/" class="block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 rounded-lg transition">Start Pro Trial</a>
        </div>
        <div class="bg-gray-800/40 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <h3 class="font-semibold text-gray-400 mb-2">Team</h3>
          <p class="text-4xl font-extrabold mb-1">$49<span class="text-lg font-medium text-gray-400">/mo</span></p>
          <p class="text-gray-500 text-sm mb-6">Per workspace</p>
          <ul class="text-sm text-gray-400 space-y-3 mb-8 text-left">
            <li class="flex gap-2"><span class="text-green-400">✓</span> Unlimited sites</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Team collaboration</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Custom agent training</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> API access</li>
          </ul>
          <a href="/" class="block border border-gray-600 hover:border-gray-400 text-gray-300 font-semibold py-2.5 rounded-lg transition">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-gray-900/50 relative z-10">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Ready to Build Something?</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">Start building for free. No credit card required.</p>
    </div>
  </section>

  <script client:load>
    // Typing animation for example prompts
    const examples = [
      "I want a portfolio for my cat photos",
      "Build me a SaaS landing page but make it cute",
      "A restaurant site with a menu that looks delicious",
      "Personal blog about my gardening hobby",
      "E-commerce store for handmade candles",
      "A band website that doesn't look like 2003",
      "Job board for weird jobs only",
      "A site for my underground mushroom club",
    ];
    const el = document.getElementById('typed-text');
    if (el) {
      let exIdx = 0;
      let chIdx = 0;
      let deleting = false;
      const speed = 55;
      const deleteSpeed = 30;
      const pause = 2500;

      function type() {
        const text = examples[exIdx];
        if (!deleting) {
          el.textContent = text.substring(0, chIdx + 1);
          chIdx++;
          if (chIdx === text.length) {
            setTimeout(() => { deleting = true; type(); }, pause);
            return;
          }
          setTimeout(type, speed);
        } else {
          el.textContent = text.substring(0, chIdx - 1);
          chIdx--;
          if (chIdx === 0) {
            deleting = false;
            exIdx = (exIdx + 1) % examples.length;
            setTimeout(type, 400);
            return;
          }
          setTimeout(type, deleteSpeed);
        }
      }
      setTimeout(type, 1000);
    }

    // App form handler
    const form = document.getElementById('app-form');
    const status = document.getElementById('app-status');
    const output = document.getElementById('app-output');
    const codeEl = document.getElementById('app-code');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const prompt = form.querySelector('textarea[name="prompt"]').value.trim();
        if (!prompt) return;

        // Disable button
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Building...';

        // Show status
        status.classList.remove('hidden');
        output.classList.add('hidden');

        try {
          const res = await fetch('/api/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt }),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({ error: 'Generation failed' }));
            throw new Error(err.error || `HTTP ${res.status}`);
          }

          const data = await res.json();
          codeEl.textContent = data.code;
          output.classList.remove('hidden');
        } catch (err) {
          codeEl.textContent = `Error: ${err.message}`;
          output.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Build My Site ✨';
        }
      });
    }
  </script>
</Layout>
