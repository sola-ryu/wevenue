---
import Layout from '../components/Layout.astro';
---

<Layout title="Pricing — Wevenue">
  <section class="min-h-screen pt-32 pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <h1 class="text-5xl sm:text-7xl font-extrabold text-center mb-6 bg-clip-text text-transparent bg-linear-to-r from-indigo-500 via-purple-500 to-pink-500">
        Simple Pricing
      </h1>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-20 text-lg">Start free. Scale when you're ready. ✨</p>

      <div class="grid sm:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <!-- Free -->
        <div class="bg-gray-800/40 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <h3 class="font-semibold text-gray-400 mb-2">Free</h3>
          <p class="text-4xl font-extrabold mb-1">$0</p>
          <p class="text-gray-500 text-sm mb-6">Forever</p>
          <ul class="text-sm text-gray-400 space-y-3 mb-8 text-left">
            <li class="flex gap-2"><span class="text-green-400">✓</span> 1 site</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> GitHub Pages deploy</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Basic agent support</li>
          </ul>
          <a href="/" class="block border border-gray-600 hover:border-gray-400 text-gray-300 font-semibold py-2.5 rounded-lg transition">Get Started</a>
        </div>

        <!-- Pro -->
        <div class="bg-indigo-600/10 border-2 border-indigo-500 rounded-2xl p-8 text-center relative agent-card">
          <p class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-600 text-white text-xs font-semibold px-3 py-1 rounded-full sparkle">Popular</p>
          <h3 class="font-semibold text-indigo-400 mb-2">Pro</h3>
          <p class="text-4xl font-extrabold mb-1">$19<span class="text-lg font-medium text-gray-400">/mo</span></p>
          <p class="text-gray-500 text-sm mb-6">Billed monthly</p>
          <ul class="text-sm text-gray-300 space-y-3 mb-8 text-left">
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> 10 sites</li>
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> Custom domains</li>
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> Multi-agent coordination</li>
            <li class="flex gap-2"><span class="text-indigo-400">✓</span> Priority generation</li>
          </ul>
          <a href="/" class="block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 rounded-lg transition">Start Pro Trial</a>
        </div>

        <!-- Team -->
        <div class="bg-gray-800/40 border border-gray-700 rounded-2xl p-8 text-center agent-card">
          <h3 class="font-semibold text-gray-400 mb-2">Team</h3>
          <p class="text-4xl font-extrabold mb-1">$49<span class="text-lg font-medium text-gray-400">/mo</span></p>
          <p class="text-gray-500 text-sm mb-6">Per workspace</p>
          <ul class="text-sm text-gray-400 space-y-3 mb-8 text-left">
            <li class="flex gap-2"><span class="text-green-400">✓</span> Unlimited sites</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Team collaboration</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Custom agent training</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> API access</li>
          </ul>
          <a href="/" class="block border border-gray-600 hover:border-gray-400 text-gray-300 font-semibold py-2.5 rounded-lg transition">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
