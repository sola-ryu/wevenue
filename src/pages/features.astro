---
import Layout from '../components/Layout.astro';
---

<Layout title="Features — Wevenue">
  <!-- Hero -->
  <section class="min-h-screen flex items-center justify-center hero-glow pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-purple-400 font-semibold text-sm tracking-wide uppercase mb-4 sparkle">✨ Features ✨</p>
      <h1 class="text-5xl sm:text-7xl font-extrabold leading-tight tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">
        Everything you need.<br />And then some.
      </h1>
      <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
        What makes Wevenue agents worth your time? Let us count the ways.
      </p>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-lg font-semibold mb-3">Instant Generation</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Full multi-page sites in under a minute! Responsive, accessible, and SEO-ready out of the box.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-purple-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">🧠</div>
          <h3 class="text-lg font-semibold mb-3">Multi-Agent Coordination</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Specialized agents for design, code, and quality review — no single model doing everything poorly.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-pink-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">🔄</div>
          <h3 class="text-lg font-semibold mb-3">Continuous Iteration</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Your site evolves with you! Ask for tweaks, new sections, or a complete redesign — all conversationally.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-green-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-lg font-semibold mb-3">One-Click Deploy</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Push to GitHub Pages, Vercel, or any host! Custom domains supported from day one.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-yellow-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">🔒</div>
          <h3 class="text-lg font-semibold mb-3">Clean Code Output</h3>
          <p class="text-gray-400 leading-relaxed text-sm">No black boxes! You get readable, well-structured HTML/CSS/JS you can take anywhere.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-cyan-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-lg font-semibold mb-3">Natural Language First</h3>
          <p class="text-gray-400 leading-relaxed text-sm">No templates to pick from, no knobs to turn! Just describe what you want and watch it appear.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">🎨</div>
          <h3 class="text-lg font-semibold mb-3">Beautiful by Default</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Every site we make is gorgeous out of the box! Pretty colors, smooth animations, and layouts that just work.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-purple-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">📱</div>
          <h3 class="text-lg font-semibold mb-3">Mobile-First</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Your site looks amazing on every screen! Phones, tablets, desktops — we make sure it's perfect everywhere.</p>
        </div>
        <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 hover:border-pink-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">🚀</div>
          <h3 class="text-lg font-semibold mb-3">Blazing Fast</h3>
          <p class="text-gray-400 leading-relaxed text-sm">Optimized for speed! Your pages load quick so visitors stay happy. Nobody likes a slow website.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="py-20 bg-gray-900/50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-12">Why Wevenue?</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-gray-800/50 border border-red-900/30 rounded-2xl p-8">
          <h3 class="text-lg font-semibold mb-4 text-red-400">Other Builders</h3>
          <ul class="space-y-3 text-gray-400 text-sm leading-relaxed">
            <li class="flex gap-2"><span class="text-red-400">✗</span> Drag-and-drop is confusing</li>
            <li class="flex gap-2"><span class="text-red-400">✗</span> Templates look the same</li>
            <li class="flex gap-2"><span class="text-red-400">✗</span> Hard to customize</li>
            <li class="flex gap-2"><span class="text-red-400">✗</span> Expensive monthly fees</li>
            <li class="flex gap-2"><span class="text-red-400">✗</span> Slow loading pages</li>
          </ul>
        </div>
        <div class="bg-gray-800/50 border border-green-900/30 rounded-2xl p-8">
          <h3 class="text-lg font-semibold mb-4 text-green-400">Wevenue</h3>
          <ul class="space-y-3 text-gray-300 text-sm leading-relaxed">
            <li class="flex gap-2"><span class="text-green-400">✓</span> Just describe what you want</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Unique designs every time</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> You stay in control</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Free plan available</li>
            <li class="flex gap-2"><span class="text-green-400">✓</span> Lightning fast</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Sounds good? Let's go!</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">Join the waitlist and be first when Wevenue launches! No credit card required.</p>
      <a href="/" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-lg">Join the Waitlist</a>
    </div>
  </section>
</Layout>
